# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
site/

# Environments
.venv/

# Tool caches
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage/
.audit/
.soak/
htmlcov/
.mutants/

# Editors
.idea/
.vscode/

# Secrets — GitLab project access tokens live in the working tree as *.gplat.
# This rule was present before the scaffold commit and was lost when that commit
# rewrote the file; restored here. Without it `git add -A` in a fresh clone
# commits a live credential.
*.gplat

# Evidence written by a run from the repo root. Keep the directory, never its contents.
artifacts/*
!artifacts/.gitkeep
